{
  "name": "localpocket",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Local-first Pocket alternative — save pages to plain files you own.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "build:all": "wxt build && wxt build -b firefox && wxt build -b safari",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "wxt": "^0.20.0"
  }
}
